# FinXplore backend / pipeline configuration (local development).
# Copy to `.env` and fill in. Never commit `.env`.
# In AWS, these same names are set as Lambda environment variables by Terraform.

# ---------- AWS ----------
AWS_REGION=us-east-1
# Named profile from ~/.aws/config (local dev only; CI uses GitHub OIDC, not keys)
AWS_PROFILE=finxplore-dev
ENVIRONMENT=dev

# ---------- SEC EDGAR (fair-access rules) ----------
# SEC requires a descriptive User-Agent with a contact email: "AppName contact@example.com"
SEC_USER_AGENT="FinXplore your-email@example.com"
# SEC allows max 10 req/s; stay well under it
SEC_MAX_REQUESTS_PER_SECOND=5

# ---------- Data lake ----------
# Terraform creates edgar-lake-<account-id>
DATA_LAKE_BUCKET=edgar-lake-000000000000
GLUE_DATABASE=finxplore
ATHENA_WORKGROUP=finxplore-app
ATHENA_AI_WORKGROUP=ai-readonly

# ---------- DynamoDB ----------
DDB_USERS_TABLE=finxplore-dev-Users
DDB_QUERY_CACHE_TABLE=finxplore-dev-QueryCache
DDB_WATCHLISTS_TABLE=finxplore-dev-Watchlists
DDB_PIPELINE_RUNS_TABLE=finxplore-dev-PipelineRuns

# ---------- AI (Bedrock) ----------
# Leave empty until a model is chosen with the eval set (see backend/evals/README.md).
# Use the exact model / inference-profile ID from the Bedrock console for your region.
BEDROCK_MODEL_ID=
AI_DAILY_QUOTA_PER_USER=20
AI_GLOBAL_DAILY_CAP=300
AI_MAX_RESULT_ROWS=100
# SSM parameter that acts as the AI kill switch ("on" / "off")
AI_KILL_SWITCH_PARAM=/finxplore/dev/ai_enabled

# ---------- Powertools ----------
POWERTOOLS_SERVICE_NAME=finxplore
POWERTOOLS_LOG_LEVEL=INFO
