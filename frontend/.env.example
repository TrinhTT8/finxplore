# FinXplore frontend config. Copy to `.env.local` (git-ignored).
# Only variables prefixed with VITE_ are exposed to the browser, so NEVER put secrets here.

# API Gateway base URL (from `terraform output api_url`)
VITE_API_BASE_URL=http://localhost:3000

# Cognito (Phase 4, from Terraform outputs). Public identifiers, not secrets.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
